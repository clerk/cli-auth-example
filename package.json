{
	"name": "@clerk/cli-auth",
	"version": "0.0.1",
	"description": "Reusable OAuth + PKCE localhost-callback flow for CLIs using Clerk. Local prototype — do not publish.",
	"private": true,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "src", "README.md"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"dependencies": {
		"@napi-rs/keyring": "^1.1.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.9.0",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2",
		"vitest": "^2.1.6"
	},
	"engines": {
		"node": ">=18"
	}
}
